# Copy to .env and fill in. Never commit .env.

# Keep /api in development so requests go through the Vite proxy (same origin, cookie works).
VITE_API_URL=/api

# Google Sign-In client ID. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Midtrans client key (the SB-Mid-client-... key for sandbox). Must match MIDTRANS_CLIENT_KEY on the server.
VITE_MIDTRANS_CLIENT_KEY=
# "false" loads the sandbox Snap script. Set "true" only with production keys.
VITE_MIDTRANS_IS_PRODUCTION=false
