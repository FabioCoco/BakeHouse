# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas (replica set is required for checkout transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bakehouse?retryWrites=true&w=majority

# At least 32 characters
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Optional: lax (default in development) | strict | none (default in production, requires HTTPS)
COOKIE_SAME_SITE=

# Google Sign-In client ID (the audience of incoming ID tokens)
GOOGLE_CLIENT_ID=

# Rate limit for /api/auth/* per 15 minutes, per IP
AUTH_RATE_LIMIT_MAX=100

# Shipping in Rupiah. Orders with a subtotal at or above FREE_SHIPPING_THRESHOLD ship free.
SHIPPING_FEE=15000
FREE_SHIPPING_THRESHOLD=250000

# Midtrans Snap (sandbox). Keys come from the Midtrans dashboard, Settings > Access Keys.
# Required at startup. Use SB-Mid-server-... and SB-Mid-client-... keys for sandbox.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "false" uses the sandbox. Set "true" only with production keys.
MIDTRANS_IS_PRODUCTION=false

# Seed data (npm run seed)
SEED_ADMIN_EMAIL=admin@bakehouse.test
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_CUSTOMER_PASSWORD=Customer123
